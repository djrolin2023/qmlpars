# 依赖
node_modules/

# 环境变量（含密钥，禁止提交）
.env
.env.example

# 运行时数据（数据库与上传文件，禁止提交）
data/
*.db
*.db-shm
*.db-wal
uploads/
cpsb/Images/uploads/

# 日志 / 运行时产物
*.log
npm-debug.log*
nohup.out

# 备份 / 临时文件
*.bak
*.tar.gz
.smoke*
*.cjs
*.mjs
.backup/.upload/
backup/trash-*/
backup/.restore-*/
web/backup/        # 后台导出的数据备份（含敏感数据，禁止提交）

# APP 打包产物（体积大，本地生成，不提交）
app/downloads/
web/android/          # buildapp.js 自动从 web/h5 生成（扁平 www），无需手工维护/提交
android-app/www/      # Capacitor 打包目录，由 buildapp.js 从 web/android 同步生成

# 系统 / 编辑器
.DS_Store
.idea/
.vscode/
*.swp

# pm2
.pm2/

# gradle 缓存（体积大，非源码）
.gradle_cache/

# 打包配置（含本机服务器地址/签名别名，本地化，不提交）
buildapp.config.json

# 在线升级临时文件
.qm-upgrade/
.qm-upgrade.lock

# 不提交含隐私信息的本地笔记
tare.md

# 安卓 APP 打包 staging 目录（构建产物，非源码）
web/.build-Android/
