#!/bin/bash
# ============================================================
# qm —— qmlpars 命令行控制面板
# 提供中文菜单：修改管理员密码、修改端口、重启服务等
# 安装时由 install.sh 复制为 /usr/local/bin/qm 并写入 QMLPARS_HOME
# ============================================================
set -e

# 安装目录（由 install.sh 注入；找不到时尝试常见位置）
QMLPARS_HOME="${QMLPARS_HOME:-/wwwroot/qmlpars}"
if [ ! -d "$QMLPARS_HOME" ]; then
  for d in /wwwroot/qmlpars /opt/qmlpars /volume1/web/jyedu; do
    if [ -d "$d" ] && [ -f "$d/index.js" ]; then QMLPARS_HOME="$d"; break; fi
  done
fi
if [ ! -f "$QMLPARS_HOME/index.js" ]; then
  echo "!! 未找到 qmlpars 安装目录（期望含 index.js）。"
  echo "   请确认已执行 install.sh 安装，或手动设置： export QMLPARS_HOME=/你的/安装/目录"
  exit 1
fi

SERVICE_NAME="qmlpars"
ENV_FILE="$QMLPARS_HOME/.env"
NGINX_CONF="/etc/nginx/conf.d/${SERVICE_NAME}.conf"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
CYAN='\033[0;36m'; WHITE='\033[0;37m'; GRAY='\033[1;30m'; DARK='\033[2;30m'; BOLD='\033[1m'
info(){ echo -e "${GREEN}[qm]${NC} $*"; }
warn(){ echo -e "${YELLOW}[qm]${NC} $*"; }
err(){  echo -e "${RED}[qm]${NC} $*"; }

# ---------- 工具：读 .env 中变量 ----------
read_env() {
  local key="$1" default="$2"
  local val=""
  if [ -f "$ENV_FILE" ]; then
    val="$(grep "^${key}=" "$ENV_FILE" 2>/dev/null | tail -1 | sed "s/^${key}=//")"
  fi
  echo "${val:-$default}"
}

# ---------- 工具：写 .env 中变量 ----------
write_env() {
  local key="$1" val="$2"
  if [ -f "$ENV_FILE" ] && grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s#^${key}=.*#${key}=${val}#" "$ENV_FILE"
  else
    echo "${key}=${val}" >> "$ENV_FILE"
  fi
}

# ---------- 工具：密码 * 回显输入 ----------
read_password() {
  local prompt="$1" pass=""
  echo -n "$prompt"
  local char
  while IFS= read -r -s -n1 char; do
    if [ -z "$char" ]; then break
    elif [ "$char" = $'\177' ] || [ "$char" = $'\b' ]; then
      if [ -n "$pass" ]; then pass="${pass%?}"; printf '\b \b'; fi
    else pass+="$char"; printf '*'
    fi
  done
  echo
  echo "$pass"
}

# 一次性命令执行完后的收尾：暂停，避免菜单刷屏
press_return() {
  local msg="${1:-操作完成，按回车返回菜单...}"
  read -rp "$msg" _
}

# ---------- 17. 在场车辆 ----------
show_present() {
  local db="$QMLPARS_HOME/data/vehicles.db"
  [ -f "$db" ] || { err "数据库不存在：$db"; press_return; return; }
  echo -e "${BOLD}========== 近 30 分钟在场车辆 ==========${NC}"
  local rows
  rows=$(sqlite3 -noheader -separator '|' "$db" "
    SELECT plateNo, channel, flag, MAX(createdAt)
    FROM recognition_logs
    WHERE createdAt >= datetime('now','localtime','-30 minutes')
    GROUP BY plateNo ORDER BY MAX(createdAt) DESC LIMIT 100;" 2>/dev/null)
  if [ -z "$rows" ]; then
    warn "近 30 分钟无在场车辆记录"
  else
    local data=()
    while IFS='|' read -r p ch fl t; do
      local tag=""
      [ "$fl" = "black" ] && tag="${RED}黑名单${NC}"
      [ "$fl" = "white" ] && tag="${GREEN}白名单${NC}"
      [ -z "$tag" ] && tag="普通"
      data+=("$p|$ch|$tag|$t")
    done <<< "$rows"
    print_table "车牌|通道|类型|最近出现" "${data[@]}"
  fi
  echo -e "${BOLD}==========================================${NC}"
  press_return
}

# ---------- 18. 黑白名单 ----------
show_lists() {
  local db="$QMLPARS_HOME/data/vehicles.db"
  [ -f "$db" ] || { err "数据库不存在：$db"; press_return; return; }
  for t in black white; do
    local title="黑名单"; [ "$t" = "white" ] && title="白名单"
    echo -e "${BOLD}========== $title ==========${NC}"
    local rows
    rows=$(sqlite3 -noheader -separator '|' "$db" "SELECT plateNo, reason, createdAt FROM vehicle_lists WHERE type='$t' ORDER BY createdAt DESC LIMIT 200;" 2>/dev/null)
    if [ -z "$rows" ]; then
      warn "（无记录）"
    else
      local data=()
      while IFS='|' read -r p r c; do data+=("$p|${r:---}|$c"); done <<< "$rows"
      print_table "车牌|备注|添加时间" "${data[@]}"
    fi
    echo ""
  done
  echo -e "${BOLD}======================================${NC}"
  press_return
}

# ---------- 工具：重启服务 + nginx 重载 ----------
restart_all() {
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files | grep -q "${SERVICE_NAME}.service"; then
    systemctl restart ${SERVICE_NAME} && info "后端服务已重启" || err "后端服务重启失败"
  else
    pkill -f "node $QMLPARS_HOME/index.js" 2>/dev/null || true
    ( cd "$QMLPARS_HOME" && nohup node index.js >/dev/null 2>&1 & disown ) && info "后端进程已重启" || err "后端进程重启失败"
  fi
  if command -v nginx >/dev/null 2>&1; then
    nginx -t >/dev/null 2>&1 && (systemctl reload nginx 2>/dev/null || true) && info "nginx 已重载"
  fi
}

# ---------- 1. 修改管理员密码 ----------
change_password() {
  local old new1 new2
  old="$(read_password '请输入当前管理员密码： ')"
  while [ ${#old} -lt 1 ]; do old="$(read_password '当前密码不能为空，请重新输入： ')"; done
  new1="$(read_password '请输入新密码（至少6位）： ')"
  while [ ${#new1} -lt 6 ]; do new1="$(read_password '密码至少 6 位，请重新输入： ')"; done
  new2="$(read_password '再次确认新密码： ')"
  while [ "$new1" != "$new2" ]; do
    warn "两次输入不一致"; new1="$(read_password '请输入新密码（至少6位）： ')"; new2="$(read_password '再次确认新密码： ')"
  done
  # 通过 node 校验旧密码并写入新哈希（直接写数据库 settings，与登录逻辑一致）
  local res
  res="$(cd "$QMLPARS_HOME" && node -e "
    const {hashPassword, verifyPassword} = require('./auth');
    const config = require('./config');
    const oldP = process.argv[1], newP = process.argv[2];
    const ok = config.ADMIN_PASSWORD_HASH ? verifyPassword(oldP, config.ADMIN_PASSWORD_HASH) : (config.ADMIN_PASSWORD && oldP === config.ADMIN_PASSWORD);
    if (!ok) { console.log('OLD_WRONG'); process.exit(0); }
    config.dbSet('ADMIN_PASSWORD_HASH', hashPassword(newP));
    config.dbSet('ADMIN_PASSWORD', '');
    console.log('OK');
  " "$old" "$new1" 2>&1)"
  if echo "$res" | grep -q 'OK'; then
    info "管理员密码已修改，请重新登录 /admin"
  elif echo "$res" | grep -q 'OLD_WRONG'; then
    err "当前密码错误，修改失败"
  else
    err "修改失败：$res"
  fi
  press_return
}

# ---------- 2. 修改端口 ----------
change_port() {
  local oldport newport
  oldport="$(read_env PORT 7081)"
  info "当前端口：$oldport"
  read -rp "请输入新端口 (1-65535) [默认 $oldport]： " newport
  newport="${newport:-$oldport}"
  while ! [[ "$newport" =~ ^[0-9]+$ ]] || [ "$newport" -lt 1 ] || [ "$newport" -gt 65535 ]; do
    read -rp "端口必须是 1-65535 的数字，请重新输入： " newport
    newport="${newport:-$oldport}"
  done
  if [ "$newport" = "$oldport" ]; then info "端口未变更"; return; fi
  write_env PORT "$newport"
  # 同步 nginx 反代端口
  if [ -f "$NGINX_CONF" ]; then
    sed -i "s#proxy_pass http://127.0.0.1:[0-9]*;#proxy_pass http://127.0.0.1:${newport};#g" "$NGINX_CONF"
    info "nginx 反代端口已更新为 $newport"
  fi
  restart_all
  info "端口已修改为 $newport"
  press_return
}

# ---------- 3. 修改域名 ----------
change_domain() {
  local olddomain newdomain
  olddomain="$(read_env BASE_URL | sed 's#^https\?://##; s#/.*##')"
  [ -z "$olddomain" ] && olddomain="$(hostname -I | awk '{print $1}')"
  info "当前域名/IP：$olddomain"
  read -rp "请输入新域名或IP（不带端口）： " newdomain
  while [ -z "$newdomain" ]; do read -rp "不能为空，请重新输入： " newdomain; done
  write_env BASE_URL "https://$newdomain"
  if [ -f "$NGINX_CONF" ]; then
    sed -i "s#server_name .*;#server_name ${newdomain};#" "$NGINX_CONF"
    info "nginx server_name 已更新为 $newdomain"
    # 若为域名，尝试重新申请证书
    if ! echo "$newdomain" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
      if command -v certbot >/dev/null 2>&1; then
        warn "尝试为 $newdomain 重新申请证书（需 80 端口可达）..."
        certbot --nginx -d "$newdomain" --non-interactive --agree-tos -m admin@${newdomain} --redirect || warn "证书申请失败，可稍后手动 certbot --nginx -d $newdomain"
      fi
    fi
  fi
  restart_all
  info "域名已修改为 $newdomain"
  press_return
}

# ---------- 4. 重启服务 ----------
do_restart() { restart_all; press_return; }

# ---------- 5. 查看状态 ----------
show_status() {
  local port svc nginx_st db_st
  port="$(read_env PORT 7081)"
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files | grep -q "${SERVICE_NAME}.service"; then
    if systemctl is-active --quiet ${SERVICE_NAME}; then svc="${GREEN}运行中${NC}"; else svc="${RED}未运行${NC}"; fi
  else
    if (ss -ltnp 2>/dev/null || netstat -ltnp 2>/dev/null) | grep -q ":$port "; then
      svc="${GREEN}运行中(进程)${NC}"; else svc="${RED}未运行${NC}"; fi
  fi
  if command -v nginx >/dev/null 2>&1; then
    if nginx -t >/dev/null 2>&1; then nginx_st="${GREEN}正常${NC}"; else nginx_st="${RED}配置异常${NC}"; fi
  else nginx_st="${YELLOW}未安装${NC}"; fi
  [ -f "$QMLPARS_HOME/data/vehicles.db" ] && db_st="${GREEN}存在${NC}" || db_st="${RED}缺失${NC}"
  echo -e "${BOLD}========== qmlpars 运行状态 ==========${NC}"
  print_table "项目|值" \
    "安装目录|$QMLPARS_HOME" \
    "监听端口|$port" \
    "访问标识|$(read_env BASE_URL '-')" \
    "服务状态|$svc" \
    "nginx|$nginx_st" \
    "数据库|$db_st"
  echo -e "${BOLD}====================================${NC}"
  press_return
}

# ---------- 6. 查看服务日志 ----------
view_logs() {
  local n="${1:-50}"
  if command -v journalctl >/dev/null 2>&1 && systemctl list-unit-files | grep -q "${SERVICE_NAME}.service"; then
    info "最近 $n 行日志（journalctl -u ${SERVICE_NAME}）："
    journalctl -u ${SERVICE_NAME} --no-pager -n "$n"
  elif [ -f "$QMLPARS_HOME/server.log" ]; then
    info "最近 $n 行日志（$QMLPARS_HOME/server.log）："
    tail -n "$n" "$QMLPARS_HOME/server.log"
  else
    err "未找到日志来源（无 systemd 也无 server.log）"
  fi
  press_return
}

# ---------- 7. 系统体检 ----------
doctor() {
  local port p res
  port="$(read_env PORT 7081)"
  # 端口监听
  if (ss -ltnp 2>/dev/null || netstat -ltnp 2>/dev/null) | grep -q ":$port "; then
    res="${GREEN}✓ 端口 $port 监听中${NC}"
  else
    res="${RED}✗ 端口 $port 未监听（服务可能未启动）${NC}"
  fi
  # 服务进程
  if pgrep -f "node $QMLPARS_HOME/index.js" >/dev/null 2>&1 || (systemctl is-active --quiet ${SERVICE_NAME} 2>/dev/null); then
    local s2="${GREEN}✓ 后端进程/服务运行中${NC}"
  else
    local s2="${RED}✗ 后端进程未运行${NC}"
  fi
  # 数据库
  if [ -f "$QMLPARS_HOME/data/vehicles.db" ]; then
    local s3="${GREEN}✓ 数据库 vehicles.db 存在${NC}"
  else
    local s3="${RED}✗ 数据库 vehicles.db 缺失${NC}"
  fi
  # 磁盘
  local disk="$(df -h "$QMLPARS_HOME" 2>/dev/null | awk 'NR==2{print $5" 已用 ("$4" 可用)"}')"
  local s4="${YELLOW}磁盘占用：${disk}${NC}"
  echo -e "${BOLD}========== qmlpars 系统体检 ==========${NC}"
  print_table "检查项|结果" \
    "端口监听|$res" \
    "后端进程|$s2" \
    "数据库|$s3" \
    "磁盘空间|$s4"
  # OCR 通道
  echo ""
  echo -e "${BOLD}OCR 通道启用情况：${NC}"
  local ocr_rows=()
  for ch in BAIDU TENCENT ALIYUN HUAWEI; do
    local k="${ch}_ENABLED"
    if [ "$(read_env $k 0)" = "1" ] || [ "$(read_env $k false)" = "true" ]; then
      ocr_rows+=("$ch|${GREEN}已启用${NC}")
    else
      ocr_rows+=("$ch|未启用")
    fi
  done
  print_table "通道|状态" "${ocr_rows[@]}"
  echo -e "${BOLD}====================================${NC}"
  press_return
}

# ---------- 8. 一键备份 ----------
backup() {
  local ts bdir dest
  ts="$(date +%Y%m%d_%H%M%S)"
  bdir="$QMLPARS_HOME/backups"
  mkdir -p "$bdir"
  dest="$bdir/qmlpars_backup_${ts}.tar.gz"
  info "开始备份到 $dest ..."
  tar -czf "$dest" -C "$QMLPARS_HOME" \
    --exclude='./node_modules' --exclude='./backups' --exclude='./.git' \
    data uploads web/admin/js/plate-areas.json .env version.json 2>/dev/null || \
  tar -czf "$dest" -C "$QMLPARS_HOME" data uploads .env version.json 2>/dev/null
  if [ -f "$dest" ]; then
    info "备份完成：$(du -h "$dest" | awk '{print $1}')"
    ls -lh "$bdir" | tail -5
  else
    err "备份失败"
  fi
}

# ---------- 9. 从备份恢复 ----------
restore() {
  local bdir f
  bdir="$QMLPARS_HOME/backups"
  if [ ! -d "$bdir" ]; then err "未找到备份目录 $bdir"; return; fi
  echo "可用备份："
  local i=1; local files=()
  for f in "$bdir"/*.tar.gz; do [ -f "$f" ] || continue; echo "  $i) $(basename "$f")"; files+=("$f"); i=$((i+1)); done
  [ ${#files[@]} -eq 0 ] && { err "无可用备份"; return; }
  read -rp "请选择要恢复的备份编号： " sel
  if ! [[ "$sel" =~ ^[0-9]+$ ]] || [ "$sel" -lt 1 ] || [ "$sel" -gt ${#files[@]} ]; then err "无效选择"; return; fi
  local chosen="${files[$((sel-1))]}"
  warn "恢复将覆盖当前 data/ 与 uploads/，是否继续？(y/N)"
  read -rp "确认： " ok
  [ "$ok" = "y" ] || [ "$ok" = "Y" ] || { info "已取消"; return; }
  tar -xzf "$chosen" -C "$QMLPARS_HOME"
  info "恢复完成，正在重启服务..."
  restart_all
  press_return
}

# ---------- 8. 生成诊断包（发给开发者排查） ----------
diag_report() {
  local ts dest tmp
  ts="$(date +%Y%m%d_%H%M%S)"
  tmp="$(mktemp -d)"
  dest="$QMLPARS_HOME/backups/qmlpars-diag-${ts}.tar.gz"
  mkdir -p "$QMLPARS_HOME/backups"
  info "正在收集诊断信息..."
  # 系统信息
  {
    echo "=== uname ==="; uname -a
    echo "=== node ==="; node -v 2>/dev/null; npm -v 2>/dev/null
    echo "=== disk ==="; df -h "$QMLPARS_HOME" 2>/dev/null
    echo "=== mem ==="; free -h 2>/dev/null || cat /proc/meminfo | head -3
  } > "$tmp/system.txt" 2>&1
  # 服务状态
  if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files | grep -q "${SERVICE_NAME}.service"; then
    systemctl status ${SERVICE_NAME} --no-pager > "$tmp/service.txt" 2>&1
    journalctl -u ${SERVICE_NAME} --no-pager -n 200 > "$tmp/journal.log" 2>&1
  fi
  # nginx 配置
  [ -f "$NGINX_CONF" ] && cp "$NGINX_CONF" "$tmp/nginx.conf" 2>/dev/null
  # 配置脱敏（隐藏密钥/密码）
  if [ -f "$ENV_FILE" ]; then
    grep -vE 'SECRET|PASSWORD|KEY|TOKEN|AK|SK|ID' "$ENV_FILE" > "$tmp/env.safe" 2>/dev/null || true
  fi
  # DB 表清单 + 行数 + 识别记录最近 50 条（脱敏车牌）
  if [ -f "$QMLPARS_HOME/data/vehicles.db" ]; then
    sqlite3 "$QMLPARS_HOME/data/vehicles.db" ".tables" > "$tmp/db_tables.txt" 2>/dev/null || true
  fi
  tar -czf "$dest" -C "$tmp" . 2>/dev/null
  rm -rf "$tmp"
  if [ -f "$dest" ]; then
    info "诊断包已生成：$dest ($(du -h "$dest" | awk '{print $1}'))"
    info "可将该文件发给开发者排查（不含任何密钥/车牌明文）"
  else
    err "诊断包生成失败"
  fi
  press_return
}

# ---------- 9. 备份 / 恢复 二级菜单 ----------
submenu_backup() {
  local bdir="$QMLPARS_HOME/backups"
  while true; do
    echo ""
    echo -e "${BOLD}===== 备份 / 恢复 =====${NC}"
    print_table "序号|菜单名|说明" \
      "1|立即备份|备份 DB + uploads" \
      "2|列出备份|列出已有备份文件" \
      "3|从备份恢复|选择备份并恢复" \
      "4|清理旧备份|删除 30 天前的旧备份" \
      "0|返回|返回主菜单"
    read -rp "请选择 [0-4]： " p
    case "$p" in
      1) backup; press_return ;;
      2)
        [ -d "$bdir" ] || { err "无备份目录"; continue; }
        for f in "$bdir"/*.tar.gz; do [ -f "$f" ] || continue;
          printf "  %s  %s\n" "$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)" "$(basename "$f")"; done
        press_return
        ;;
      3) restore; press_return ;;
      4)
        local cnt=0
        for f in "$bdir"/qmlpars_backup_*.tar.gz; do
          [ -f "$f" ] || continue
          if [ "$(( $(date +%s) - $(stat -c %Y "$f") ))" -gt 2592000 ]; then rm -f "$f" && cnt=$((cnt+1)); fi
        done
        info "已清理 $cnt 个 30 天前的旧备份"
        press_return
        ;;
      0|q|Q) return 0 ;;
      *) warn "无效选择" ;;
    esac
  done
}

# ---------- 10. 清理抓拍图（prune） ----------
prune_snapshots() {
  local snap="$QMLPARS_HOME/uploads/snapshots" days
  [ -d "$snap" ] || { err "未找到抓拍目录 $snap"; return; }
  echo "清理策略："
  echo "  1) 删除 7 天前的抓拍"
  echo "  2) 删除 30 天前的抓拍"
  echo "  3) 删除全部抓拍（保留空目录）"
  read -rp "请选择 [1-3]： " s
  case "$s" in
    1) days=7 ;;
    2) days=30 ;;
    3) days=0 ;;
    *) warn "无效选择"; return ;;
  esac
  local before after
  before="$(find "$snap" -type f | wc -l)"
  if [ "$days" -eq 0 ]; then
    find "$snap" -type f -delete
  else
    find "$snap" -type f -mtime +"$days" -delete
  fi
  after="$(find "$snap" -type f | wc -l)"
  info "清理完成：原 $before 个文件，现 $after 个（释放 $(( (before-after) )) 个）"
  press_return
}

# ---------- 11. 导出识别月报 CSV ----------
export_report() {
  local db="$QMLPARS_HOME/data/vehicles.db" out
  [ -f "$db" ] || { err "未找到数据库 $db"; return; }
  out="$QMLPARS_HOME/backups/recognition_report_$(date +%Y%m).csv"
  mkdir -p "$QMLPARS_HOME/backups"
  info "正在导出识别记录..."
  sqlite3 -header -csv "$db" \
    "SELECT strftime('%Y-%m', createdAt) AS 月份, COUNT(*) AS 识别次数,
            SUM(CASE WHEN result='成功' THEN 1 ELSE 0 END) AS 成功数,
            SUM(CASE WHEN result<>'成功' THEN 1 ELSE 0 END) AS 失败数
     FROM recognition_logs GROUP BY strftime('%Y-%m', createdAt) ORDER BY 月份 DESC;" \
    > "$out" 2>/dev/null
  if [ -s "$out" ]; then
    info "月报已导出：$out"
    cat "$out"
  else
    warn "无识别记录可导出"
  fi
  press_return
}

# ---------- 10. 配置 OCR 通道 ----------
ocr_set() {
  echo "可用的 OCR 通道： baidu / tencent / aliyun / huawei"
  read -rp "要配置的通道（小写）： " ch
  ch="$(echo "$ch" | tr '[:lower:]' '[:upper:]')"
  case "$ch" in
    BAIDU|TENCENT|ALIYUN|HUAWEI) ;;
    *) err "未知通道"; return ;;
  esac
  echo "当前 ${ch} 启用状态：$(read_env ${ch}_ENABLED 0)"
  read -rp "是否启用该通道 (1/0)： " en
  write_env "${ch}_ENABLED" "$en"
