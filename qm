  info "OCR 配置已更新，重启服务后生效"
  restart_all
  press_return
}

# ---------- 11. Android 构建环境检查 ----------
build_check() {
  echo "------------------------------------------------------------"
  echo " Android 构建环境检查"
  echo "------------------------------------------------------------"
  local sdk="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
  [ -z "$sdk" ] && sdk="$(read_env ANDROID_SDK_ROOT '')"
  if [ -n "$sdk" ] && [ -d "$sdk" ]; then
    echo -e " [✓] ANDROID_SDK_ROOT=$sdk"
  else
    echo -e " ${RED}[✗] ANDROID_SDK_ROOT 未设置或目录不存在${NC}"
  fi
  for t in java gradle node npm; do
    if command -v $t >/dev/null 2>&1; then echo -e " [✓] $t: $($t -version 2>&1 | head -1)"; else echo -e " ${RED}[✗] $t 未安装${NC}"; fi
  done
  if [ -d "$sdk" ]; then
    local need=( "platform-tools" )
    for p in "${need[@]}"; do
      [ -d "$sdk/$p" ] && echo -e " [✓] $p 已安装" || echo -e " ${YELLOW}[!] $p 缺失（sdkmanager 安装）${NC}"
    done
  fi
  echo "------------------------------------------------------------"
  press_return
}

# ---------- 16. 管理员密码重置（无旧密码，root 专用） ----------
reset_admin_password() {
  warn "此操作将直接覆盖管理员密码（无需旧密码），仅限本机 root 紧急处理"
  local new1 new2
  new1="$(read_password '请输入新密码（至少6位）： ')"
  while [ ${#new1} -lt 6 ]; do new1="$(read_password '密码至少 6 位，请重新输入： ')"; done
  new2="$(read_password '再次确认新密码： ')"
  while [ "$new1" != "$new2" ]; do
    warn "两次输入不一致"; new1="$(read_password '请输入新密码（至少6位）： ')"; new2="$(read_password '再次确认新密码： ')"
  done
  local res
  res="$(cd "$QMLPARS_HOME" && node -e "
    const {hashPassword} = require('./auth');
    const config = require('./config');
    config.dbSet('ADMIN_PASSWORD_HASH', hashPassword(process.argv[1]));
    config.dbSet('ADMIN_PASSWORD', '');
    console.log('OK');
  " "$new1" 2>&1)"
  if echo "$res" | grep -q 'OK'; then info "管理员密码已重置，请重新登录 /admin"; else err "重置失败：$res"; fi
  press_return
}

# ---------- 17. H5 用户管理（二级菜单） ----------
submenu_users() {
  while true; do
    echo ""
    echo -e "${BOLD}===== H5 用户管理 =====${NC}"
    print_table "序号|菜单名|说明" \
      "1|列出用户|列出所有 H5 用户" \
      "2|新增用户|新建 H5 用户" \
      "3|重置密码|重置用户密码" \
      "4|删除用户|删除指定用户" \
      "0|返回|返回主菜单"
    read -rp "请选择 [0-4]： " p
    case "$p" in
      1)
        cd "$QMLPARS_HOME" && node -e "
          const config=require('./config');
          const rows=config.dbAll('SELECT id,username,department,role,createdAt,lastLogin FROM users ORDER BY id');
          if(!rows.length){console.log('（无用户）');process.exit(0);}
          console.log('ID  用户名          部门        角色    创建时间');
          rows.forEach(r=>console.log(String(r.id).padEnd(4), (r.username||'').padEnd(14), (r.department||'').padEnd(10), (r.role||'').padEnd(6), r.createdAt||''));
        " 2>&1
        press_return
        ;;
      2)
        read -rp "用户名： " u; [ -z "$u" ] && { warn "用户名不能为空"; continue; }
        local pw; pw="$(read_password '初始密码（至少6位）： ')"; while [ ${#pw} -lt 6 ]; do pw="$(read_password '密码至少6位： ')"; done
        read -rp "部门（可选）： " dept
        cd "$QMLPARS_HOME" && node -e "
          const {hashPassword}=require('./auth'); const config=require('./config');
          const u=process.argv[1], pw=process.argv[2], dept=process.argv[3]||'';
          const ex=config.dbGetOne('SELECT id FROM users WHERE username=?',[u]);
          if(ex){console.log('EXIST');process.exit(0);}
          config.dbRun('INSERT INTO users(username,passwordHash,department,role,createdAt) VALUES(?,?,?,?,?)',
            [u,hashPassword(pw),dept,'user',new Date().toISOString()]);
          console.log('OK');
        " "$u" "$pw" "$dept" 2>&1 | sed 's/^/  /'
        press_return
        ;;
      3)
        read -rp "要重置的用户名： " u; [ -z "$u" ] && continue
        local np; np="$(read_password '新密码（至少6位）： ')"; while [ ${#np} -lt 6 ]; do np="$(read_password '密码至少6位： ')"; done
        cd "$QMLPARS_HOME" && node -e "
          const {hashPassword}=require('./auth'); const config=require('./config');
          const r=config.dbRun('UPDATE users SET passwordHash=? WHERE username=?',[hashPassword(process.argv[2]),process.argv[1]]);
          console.log(r.changes? 'OK':'NOTFOUND');
        " "$u" "$np" 2>&1 | sed 's/^/  /'
        press_return
        ;;
      4)
        read -rp "要删除的用户名： " u; [ -z "$u" ] && continue
        cd "$QMLPARS_HOME" && node -e "
          const config=require('./config');
          const r=config.dbRun('DELETE FROM users WHERE username=? AND role<>"admin"',[process.argv[1]]);
          console.log(r.changes? 'OK':'NOTFOUND');
        " "$u" 2>&1 | sed 's/^/  /'
        press_return
        ;;
      0|q|Q) return 0 ;;
      *) warn "无效选择" ;;
    esac
  done
}

# ---------- 18. 一键升级系统（保守） ----------
upgrade_me() {
  warn "升级将执行：git pull（若本地无改动） + npm install + 重启服务"
  read -rp "确认升级？(y/N) " ok
  [ "$ok" = "y" ] || [ "$ok" = "Y" ] || { info "已取消"; return; }
  cd "$QMLPARS_HOME"
  if [ -d .git ]; then
    if git diff --quiet 2>/dev/null; then
      git pull --ff-only 2>&1 | tail -5 && info "代码已更新" || warn "git pull 失败，请手动处理"
    else
      warn "本地有未提交改动，跳过 git pull（避免覆盖）。请手动 merge。"
    fi
  else
    warn "非 git 仓库，跳过拉取"
  fi
  if [ -f package.json ]; then
    npm install --omit=dev --no-audit --no-fund 2>&1 | tail -3 && info "依赖已更新"
  fi
  restart_all
  info "升级完成，请验证 /admin 可访问"
  press_return
}

# ---------- 通用表格渲染：按显示宽度对齐（中文=2），奇偶行交替色 ----------
# 用法： print_table "列标题1|列标题2|..."  "行1c1|行1c2|..." "行2c1|行2c2|..." ...
print_table() {
  local header="$1"; shift
  local -a rows=("$@")
  # 计算每列最大显示宽度
  local -a widths=()
  local IFS='|'
  local hcols=($header)
  local nc=${#hcols[@]}
  local i c
  for ((i=0;i<nc;i++)); do widths[i]=$(disp_len "${hcols[i]}"); done
  for r in "${rows[@]}"; do
    local rcols=($r)
    for ((i=0;i<nc;i++)); do
      local w=$(disp_len "${rcols[i]:-}")
      [ "$w" -gt "${widths[i]}" ] && widths[i]=$w
    done
  done
  # 画分隔线
  local sep="+" sepbody=""
  for ((i=0;i<nc;i++)); do
    local dash=""; for ((c=0;c<widths[i]+2;c++)); do dash+="-"; done
    sep+="${dash}+"
  done
  sepbody="$sep"
  # 渲染表头（全部居中）
  local IFS=' '; local wstr="${widths[*]}"
  local halign=""; for ((i=0;i<nc;i++)); do [ -n "$halign" ] && halign+=","; halign+="c"; done
  # 数据行对齐：第一列居中，其余居左
  local dalign="c"; for ((i=1;i<nc;i++)); do dalign+=",l"; done
  printf "${CYAN}%s${NC}\n" "$sep"
  print_row "$header" "$wstr" "$CYAN" "$halign"
  printf "${YELLOW}%s${NC}\n" "$sep"
  # 数据行，奇偶交替 + 每行下画分隔线
  local idx=0
  for r in "${rows[@]}"; do
    if [ $((idx % 2)) -eq 0 ]; then
      print_row "$r" "$wstr" "${WHITE}" "$dalign"
    else
      print_row "$r" "$wstr" "${GRAY}" "$dalign"
    fi
    # 行分隔线：偶数行下用略亮的灰，奇数行下用暗灰，强化层次
    if [ $((idx % 2)) -eq 0 ]; then
      printf "${GRAY}%s${NC}\n" "$sep"
    else
      printf "${DARK}%s${NC}\n" "$sep"
    fi
    idx=$((idx+1))
  done
  printf "${CYAN}%s${NC}\n" "$sep"
}
# 计算字符串显示宽度（CJK/全角=2，其余=1）
disp_len() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys; s=sys.argv[1]; w=sum(2 if ord(c)>0x2E7F else 1 for c in s); print(w)' "$1" 2>/dev/null && return
  fi
  # 回退：UTF-8 字节数近似（中文3字节≈2显示宽，略偏宽但能对齐）
  printf '%s' "$1" | wc -c
}
# 渲染单行
# 参数：data | wstr | col | align("c,l,l" 每列对齐：c=中 l=左 r=右)
print_row() {
  local data="$1"; local wstr="$2"; local col="$3"; local align="$4"
  local IFS=' '; local -a _w=($wstr)
  local -a acols=(${align//,/ })
  local IFS='|'; local cols=($data)
  local line="|"
  for ((i=0;i<${#_w[@]};i++)); do
    local cell="${cols[i]:-}"
    local dl=$(disp_len "$cell")
    local pad=$(( _w[i] - dl ))
    [ "$pad" -lt 0 ] && pad=0
    local a="${acols[i]:-l}"
    local lsp="" rsp=""
    if [ "$a" = "c" ]; then
      local left=$(( pad / 2 )); local right=$(( pad - left ))
      lsp="$(printf '%*s' $((left+1)) '')"; rsp="$(printf '%*s' $((right+1)) '')"
    else
      lsp=" "; rsp="$(printf '%*s' $((pad+1)) '')"
    fi
    line+="${lsp}${cell}${rsp}|"
  done
  printf "${col}%b${NC}\n" "$line"
}

